{
  "manifest_version": 3,
  "name": "MemeTube Pro - GIF, ASCII Meme & Kaomoji Studio",
  "version": "7.1.0",
  "description": "Post animated Tenor GIFs (auto-rendered), viral ASCII/Braille art memes, and Japanese Kaomoji on YouTube comments with zero-width stealth technology.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://tenor.com/*",
    "https://*.tenor.com/*",
    "https://tenor.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_end"
    }
  ]
}