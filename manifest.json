{
  "manifest_version": 3,
  "name": "MemeTube Pro v5 - Full HD Original ASCII & GIF Studio",
  "version": "5.0.0",
  "description": "Kho GIF thực từ Tenor, 35+ Tranh ASCII/Braille, 60+ Kaomoji và Máy tạo ảnh sang tranh ký tự trực tiếp trên YouTube!",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://tenor.com/*",
    "https://*.tenor.com/*",
    "https://tenor.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_end"
    }
  ]
}